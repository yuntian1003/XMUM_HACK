# ==============================================================================
# FarmGPT Environment Configuration
# ==============================================================================

# ── Application & Server ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
JWT_SECRET=<your-strong-random-jwt-secret>
VITE_APP_ID=farmgpt_app

# ── Database (Supabase PostgreSQL via Connection Pooler) ──────────────────────
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Botanical & Crop Diagnostics ──────────────────────────────────────────────
PLANTNET_API_KEY=<your-plantnet-api-key>

# ── Gemini & LLM Multimodal Reasoning ─────────────────────────────────────────
GEMINI_API_KEY=<your-gemini-api-key>
LLM_MODEL=gemini-3.1-flash-lite-preview

# ── Groq Vision / LLM Backup ──────────────────────────────────────────────────
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── FoodMonitor Cloud Run Integration ─────────────────────────────────────────
FOODMONITOR_API_BASE_URL=https://foodmonitor-15891690721.asia-southeast1.run.app
FOODMONITOR_AUDIENCE=https://foodmonitor-15891690721.asia-southeast1.run.app
FOODMONITOR_AUTH_MODE=cloud-run-id-token
FOODMONITOR_JOB_SHARED_SECRET=<your-foodmonitor-shared-secret>

# ── Frontend API Routing ──────────────────────────────────────────────────────
VITE_ALLOW_REMOTE_API_ON_LOCALHOST=true
VITE_API_BASE_URL=https://farmgpt-15891690721.asia-southeast1.run.app

# ── Vertex AI Search & Google Cloud Access ────────────────────────────────────
VERTEX_AI_SEARCH_SERVING_CONFIG=projects/utmhackathon/locations/global/collections/default_collection/dataStores/foodmonitor-factual-news-connector_1776499844942_gcs_store/servingConfigs/default_search
VERTEX_AI_SEARCH_LOCATION=global
GOOGLE_CLOUD_ACCESS_TOKEN=<your-google-cloud-access-token>

# ── Telegram Bot (PO Approval) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<get from @BotFather>
TELEGRAM_OWNER_CHAT_ID=<owner telegram chat id>