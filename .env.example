# ── Database ──────────────────────────────────────────────
DATABASE_URL=mysql://root:your_password@localhost:3306/farmgpt

# ── Authentication ────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
VITE_APP_ID=farmgpt_app

# ── Google AI / Genkit ────────────────────────────────────
# Required for AI-powered plant disease diagnosis
GOOGLE_GENAI_API_KEY=

# ── External Services (Optional) ──────────────────────────
FOODMONITOR_API_BASE_URL=
FOODMONITOR_AUDIENCE=
FOODMONITOR_AUTH_MODE=cloud-run-id-token
FOODMONITOR_JOB_SHARED_SECRET=

# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
